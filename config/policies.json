{
  "policies": [
    {
      "handler": {
        "export": "ReplaceStringOutboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "match": "null",
          "mode": "string",
          "replaceWith": "-1"
        }
      },
      "name": "replace-null-outbound",
      "policyType": "replace-string-outbound"
    },
    {
      "handler": {
        "export": "MonetizationInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "meters": {
            "requests": 1
          }
        }
      },
      "name": "monetization-inbound",
      "policyType": "monetization-inbound"
    },
    {
      "handler": {
        "export": "ApiKeyInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "allowUnauthenticatedRequests": false,
          "cacheTtlSeconds": 60
        }
      },
      "name": "api-key-inbound",
      "policyType": "api-key-inbound"
    },
    {
      "handler": {
        "export": "RateLimitInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "rateLimitBy": "ip",
          "requestsAllowed": 2,
          "timeWindowMinutes": 1
        }
      },
      "name": "rate-limit-inbound",
      "policyType": "rate-limit-inbound"
    },
    {
      "handler": {
        "export": "default",
        "module": "$import(./modules/xml)"
      },
      "name": "custom-code-outbound",
      "policyType": "custom-code-outbound"
    },
    {
      "handler": {
        "export": "XmlToJsonOutboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "attributeNamePrefix": "@_",
          "ignoreAttributes": true,
          "ignoreDeclarations": true,
          "ignoreProcessingInstructions": true,
          "parseOnStatusCodes": "200-299",
          "removeNSPrefix": true,
          "textNodeName": "#text",
          "trimValues": true
        }
      },
      "name": "xml-to-json-outbound",
      "policyType": "xml-to-json-outbound"
    },
    {
      "handler": {
        "export": "GeoFilterInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "block": {
            "countries": "US, CA, MX"
          },
          "ignoreUnknown": true
        }
      },
      "name": "geo-filter-inbound",
      "policyType": "geo-filter-inbound"
    },
    {
      "handler": {
        "export": "default",
        "module": "$import(./modules/ab-test-inbound)"
      },
      "name": "ab-test-inbound",
      "policyType": "custom-code-inbound"
    },
    {
      "handler": {
        "export": "SetHeadersInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "headers": [
            {
              "name": "Accept",
              "value": "application/xml"
            }
          ]
        }
      },
      "name": "set-accept-xml-inbound",
      "policyType": "set-headers-inbound"
    },
    {
      "handler": {
        "export": "ChangeMethodInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "method": "POST"
        }
      },
      "name": "change-method-inbound",
      "policyType": "change-method-inbound"
    },
    {
      "handler": {
        "export": "SetHeadersInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "headers": [
            {
              "name": "Authorization",
              "value": "Bearer $env(OPEN_AI)"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Host",
              "value": "api.openai.com"
            }
          ]
        }
      },
      "name": "set-openaiauth-inbound",
      "policyType": "set-headers-inbound"
    },
    {
      "handler": {
        "export": "SetBodyInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "body": ""
        }
      },
      "name": "set-funfact-body-inbound",
      "policyType": "set-body-inbound"
    },
    {
      "handler": {
        "export": "ClearHeadersInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "exclude": []
        }
      },
      "name": "clear-headers-inbound",
      "policyType": "clear-headers-inbound"
    },
    {
      "handler": {
        "export": "default",
        "module": "$import(./modules/create-body-inbound)"
      },
      "name": "create-body-inbound",
      "policyType": "custom-code-inbound"
    }
  ]
}